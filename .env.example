# Base URL del bucket/CDN para audio y video en producción (dejar vacío en desarrollo)
NEXT_PUBLIC_MEDIA_BASE_URL=

# --- Deploy estático (GitHub Pages) ---
# Prefijo de ruta si el sitio vive en un subdirectorio, ej. "/intheloop"
# para https://<usuario>.github.io/intheloop/. Vacío en dominio raíz.
# El workflow de GitHub Pages lo setea solo; hace falta solo para builds locales.
NEXT_PUBLIC_BASE_PATH=

# Origen canónico para sitemap/OG/canonical, SIN basePath (default: https://www.intheloop.agency)
# En GitHub Pages: https://<usuario>.github.io
NEXT_PUBLIC_SITE_URL=

# --- Formulario de bookings (Web3Forms) ---
# No requiere variables de entorno ni secretos: el sitio es estático y el POST se
# hace desde el navegador a https://api.web3forms.com/submit.
# La access key es PÚBLICA por diseño y vive una sola vez en
# src/lib/booking-config.ts; el destinatario y hCaptcha se configuran en el
# dashboard de Web3Forms (ver docs/CONTACT-FORM.md).
# No agregar acá claves, tokens, SMTP ni webhooks.
